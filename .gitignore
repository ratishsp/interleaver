# Virtual envs
.venv/
.venv-parler/
__pycache__/
*.pyc

# Generated audio + big corpora downloads (kept out of git; gefion/ has the small verse files)
samples/
corpora/
*.mp3
*.zip
*.wav

# Per-week build outputs (regenerable): assembled audio + verify run artifacts
year1/**/audio/
year1/**/audio_slow/
