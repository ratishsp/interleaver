# Provenance traces (TANDEM_TRACE) — kept local, published via a separate repo, not here
trace*.jsonl
*.trace.jsonl

# Logs
*.log

# Secrets — NEVER commit API keys or service-account credentials
.env
*.key.json
*-key.json
*credentials*.json
service-account*.json

# Claude runtime state
.claude/
cache/
samples/
deck/
